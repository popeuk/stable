# Be Stable — environment configuration
# Copy to .env.local and fill in. Without these, the app runs local-only
# (Zustand + localStorage) on the seeded demo stable.

# Supabase (sections 2.2 / 5)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — used by Edge Functions / route handlers (voice, OCR, insights)
SUPABASE_SERVICE_ROLE_KEY=

# AI advisor LLM — via OpenRouter (decided: OpenRouter, not the Anthropic API).
# Wired later: an edge function calls OpenRouter behind matchIntent() in
# lib/domain/advisor.ts. The key stays server-side (never shipped to the client).
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=anthropic/claude-3.5-sonnet  # pick any model on OpenRouter
