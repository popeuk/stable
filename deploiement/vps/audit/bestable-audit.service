[Unit]
Description=Be Stable : l'audit en ligne des écuries (préprod)
After=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/bestable-audit.env
# Les clés (Anthropic, DataForSEO) : fichier root en 600, lu par systemd seulement.
EnvironmentFile=-/etc/bestable-audit.secrets
ExecStart=/opt/bestable-audit/venv/bin/python -I /opt/bestable-audit/bestable-audit.py
DynamicUser=yes
StateDirectory=bestable-audit
Restart=on-failure
RestartSec=3
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
MemoryMax=300M

[Install]
WantedBy=multi-user.target
